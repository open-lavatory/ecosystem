     "@intercom/messenger-js-sdk": "^0.0.20",
     "@lingui/core": "6.3.0",
     "@lingui/react": "6.3.0",
+    "@openlv/connector": "0.2.4",
     "@posthog/react": "catalog:",
     "@radix-ui/react-alert-dialog": "^1.2.1",
     "@radix-ui/react-collapsible": "^1.2.1",
diff --git a/apps/manager/src/lib/wagmi.ts b/apps/manager/src/lib/wagmi.ts
index 3020861a8..38935214d 100644
--- a/apps/manager/src/lib/wagmi.ts
+++ b/apps/manager/src/lib/wagmi.ts
@@ -1,4 +1,5 @@
 import { WALLETCONNECT_PROJECT_ID } from '@ens-apps/config'
+import { openlv } from '@openlv/connector'
 import { createPublicClient } from 'viem'
 import { createConfig } from 'wagmi'
 import { walletConnect } from 'wagmi/connectors'
@@ -50,6 +51,7 @@ export const wagmiConfig = createConfig({
       // light-only, so pin it.
       qrModalOptions: { themeMode: 'light' },
     }),
+    openlv(),
     // Test-only: auto-signing wallet for Playwright/agents. Off in production.
     ...(isMockWalletEnabled ? [mockConnector] : []),
   ],
diff --git a/apps/manager/src/lib/wallet/stacks/custom/ConnectWalletDialog.tsx b/apps/manager/src/lib/wallet/stacks/custom/ConnectWalletDialog.tsx
index d388b1092..02670c3b0 100644
--- a/apps/manager/src/lib/wallet/stacks/custom/ConnectWalletDialog.tsx
+++ b/apps/manager/src/lib/wallet/stacks/custom/ConnectWalletDialog.tsx
@@ -18,6 +18,7 @@ import {
   isMetaMask,
   METAMASK_DOWNLOAD_URL,
   normalizeConnectError,
+  OPENLV_ID,
   WALLETCONNECT_ID,
 } from './connect.helpers'
 import { CoinbaseIcon, MetaMaskIcon, WalletConnectIcon } from './WalletIcons'
@@ -128,6 +129,7 @@ export const ConnectWalletDialog = ({
   const metaMask = connectors.find(isMetaMask)
   const coinbase = connectors.find(isCoinbase)
   const walletConnect = connectors.find((c) => c.id === WALLETCONNECT_ID)
+  const openLv = connectors.find((c) => c.id === OPENLV_ID)
 
   // Other injected wallets (Rabby, Frame, …), deduped by `uid` so wallets that
   // share a display name aren't collapsed into one.
@@ -192,7 +194,8 @@ export const ConnectWalletDialog = ({
     // WalletConnect renders its own full-screen QR modal, so close ours first
     // to avoid stacking; injected/Coinbase keep ours open with a per-row
     // "Connecting…" state and dismiss it only on success.
-    const usesOwnModal = connector.id === WALLETCONNECT_ID
+    const usesOwnModal =
+      connector.id === WALLETCONNECT_ID || connector.id === OPENLV_ID
     if (usesOwnModal) {
       onOpenChange(false)
     }
@@ -253,6 +256,18 @@ export const ConnectWalletDialog = ({
           },
         ]
       : []),
+    ...(openLv
+      ? [
+          {
+            key: 'openlv',
+            icon: (
+              <img alt="" className="size-8 rounded-xs" src={openLv.icon} />
+            ),
+            name: openLv.name,
+            connector: openLv,
+          },
+        ]
+      : []),
   ]
 
   // EIP-6963-discovered injected wallets, shown after the curated ones.
