+import { createContext, useEffect, useState, useCallback, type ReactNode } from 'react'
+import type { Session } from '@openlv/session'
+
+import useSafeInfo from '@/hooks/useSafeInfo'
+import useSafeWalletProvider, { type ChainSwitchUi } from '@/services/safe-wallet-provider/useSafeWalletProvider'
+import { IS_PRODUCTION } from '@/config/constants'
+import { asError } from '@safe-global/utils/services/exceptions/utils'
+import { OPENLV_APP_URL } from '../../constants'
+import { getPeerIcon, getPeerName, toSessionResponse } from '../../services/utils'
+import { trackRequest } from '../../services/tracking'
+import { openLVPopupStore } from '../../store/openLVPopupStore'
+import { openLVChainSwitchStore } from '../../store/openLVChainSwitchStore'
+import openLVInstance from '../../services/openLVInstance'
+import type { OpenLVContextType, OpenLVLoadingState } from '../../types'
+
+const FALLBACK_PEER_NAME = 'openlv'
+
+const chainSwitchUi: ChainSwitchUi = { popupStore: openLVPopupStore, chainSwitchStore: openLVChainSwitchStore }
+
+export const OpenLVContext = createContext<OpenLVContextType>({
+  openLV: openLVInstance,
+  sessions: [],
+  error: null,
+  setError: () => {},
+  open: false,
+  setOpen: () => {},
+  loading: null,
+  setLoading: () => {},
+})
+
+export const OpenLVProvider = ({ children }: { children: ReactNode }) => {
+  const openLV = openLVInstance
+  const open = openLVPopupStore.useStore() ?? false
+  const setOpen = openLVPopupStore.setStore
+  const [error, setError] = useState<Error | null>(null)
+  const [loading, setLoading] = useState<OpenLVLoadingState | null>(null)
+
+  const [sessions, setSessions] = useState<Session[]>(openLV.getActiveSessions())
+
+  const updateSessions = useCallback(() => {
+    setSessions(openLV.getActiveSessions())
+  }, [openLV])
+
+  useEffect(() => {
+    return openLV.onSessionAdd(updateSessions)
+  }, [openLV, updateSessions])
+
+  useEffect(() => {
+    return openLV.onSessionDelete(updateSessions)
+  }, [openLV, updateSessions])
+
+  const safeWalletProvider = useSafeWalletProvider(sessions.length > 0, chainSwitchUi)
+  const { safe } = useSafeInfo()
+
+  useEffect(() => {
+    if (!safeWalletProvider || !safe.chainId) return
+
+    return openLV.onRequest(async ({ id, session, method, params }) => {
+      if (!IS_PRODUCTION) {
+        console.log('[openlv] request', method, params)
+      }
+
+      const peer = session.peerInfo.get()
+      const peerName = getPeerName(peer) || FALLBACK_PEER_NAME
+
+      trackRequest(peer?.identity ?? '', method)
+
+      try {
+        const response = await safeWalletProvider.request(
+          id,
+          { method, params },
+          {
+            url: OPENLV_APP_URL,
+            name: peerName,
+            description: '',
+            iconUrl: getPeerIcon(peer) ?? '',
+          },
+        )
+
+        return toSessionResponse(response)
+      } catch (e) {
+        setError(asError(e))
+        throw e
+      }
+    })
+  }, [openLV, safe.chainId, safeWalletProvider])
+
+  return (
+    <OpenLVContext.Provider
+      value={{
+        openLV,
+        error,
+        setError,
+        open,
+        setOpen,
+        loading,
+        setLoading,
+        sessions,
+      }}
+    >
+      {children}
+    </OpenLVContext.Provider>
+  )
+}
