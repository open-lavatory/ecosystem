@@ -0,0 +1,28 @@
+import { useRouter } from 'next/router'
+import { useCallback } from 'react'
+import { OPENLV_URI_SEARCH_PARAM } from '../constants'
+
+export function useOpenLVSearchParamUri(): [string | null, (uri: string | null) => void] {
+  const router = useRouter()
+  const uri = (router.query[OPENLV_URI_SEARCH_PARAM] || '').toString() || null
+
+  const setUri = useCallback(
+    (uri: string | null) => {
+      const newQuery = { ...router.query }
+
+      if (!uri) {
+        delete newQuery[OPENLV_URI_SEARCH_PARAM]
+      } else {
+        newQuery[OPENLV_URI_SEARCH_PARAM] = uri
+      }
+
+      router.replace({
+        pathname: router.pathname,
+        query: newQuery,
+      })
+    },
+    [router],
+  )
+
+  return [uri, setUri]
+}
