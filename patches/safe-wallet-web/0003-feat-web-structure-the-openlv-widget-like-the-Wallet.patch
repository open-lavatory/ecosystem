+import { type ReactElement } from 'react'
+import OpenLVLogo from '@/public/images/common/openlv.svg'
+import SafeAppIconCard from '@safe-global/views/components/safe-apps/SafeAppIconCard'
+import IconAction from '@safe-global/views/components/common/IconAction'
+import { OPENLV_EVENTS } from '@/services/analytics/events/openlv'
+import Track from '@/components/common/Track'
+
+type OpenLVIconProps = {
+  onClick: () => void
+  sessionCount: number
+  isError: boolean
+  sessionIcon?: string
+}
+
+const OpenLVIcon = ({ sessionCount, sessionIcon, isError, onClick }: OpenLVIconProps): ReactElement => {
+  const showIcon = sessionCount === 1 && !!sessionIcon
+
+  return (
+    <Track {...OPENLV_EVENTS.POPUP_OPENED}>
+      <div className="relative flex items-center rounded-lg bg-muted">
+        <IconAction onClick={onClick} aria-label="openlv">
+          <OpenLVLogo className="size-5 text-muted-foreground [&_path]:fill-current [&_path]:stroke-current" />
+        </IconAction>
+
+        {isError && (
+          <span
+            className="absolute z-10 flex items-center justify-center rounded-full border-[3px] border-card bg-[var(--color-error-main)] w-[10px] h-[10px] top-[9px] right-[10px]"
+            aria-label="openlv error"
+          />
+        )}
+
+        {!isError && showIcon && (
+          <span
+            className="absolute z-10 -bottom-[2px] -right-[2px] rounded-full overflow-hidden border-2 border-card"
+            aria-label="Connected dApp"
+          >
+            <SafeAppIconCard alt="Connected dApp icon" src={sessionIcon} width={18} height={18} />
+          </span>
+        )}
+
+        {!isError && sessionCount > 1 && (
+          <span
+            className="absolute z-10 flex items-center justify-center rounded-full bg-[rgba(18,255,128,0.1)] text-[10px] font-medium leading-none text-secondary-foreground min-w-[18px] h-[18px] px-1 -top-[2px] -right-[4px]"
+            aria-label={`${sessionCount} openlv sessions`}
+          >
+            {sessionCount}
+          </span>
+        )}
+      </div>
+    </Track>
+  )
+}
+
+export default OpenLVIcon
