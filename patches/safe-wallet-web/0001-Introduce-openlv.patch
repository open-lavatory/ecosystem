+import Track from '@/components/common/Track'
+import { isOpenLVUri } from '../../services/utils'
+import { OpenLVContext } from '../OpenLVContext'
+import { OpenLVLoadingState } from '../../types'
+import useDebounce from '@safe-global/utils/hooks/useDebounce'
+import { trackEvent } from '@/services/analytics'
+import { OPENLV_EVENTS } from '@/services/analytics/events/openlv'
+import { asError } from '@safe-global/utils/services/exceptions/utils'
+import { getClipboard, isClipboardSupported } from '@/utils/clipboard'
+import { Button } from '@safe-global/views/components/ui/button'
+import { Spinner } from '@safe-global/views/components/ui/spinner'
+import { Input } from '@safe-global/views/components/ui/input'
+import { Label } from '@safe-global/views/components/ui/label'
+import { InputGroup, InputGroupInput, InputGroupAddon } from '@safe-global/views/components/ui/input-group'
+import { useCallback, useContext, useEffect, useId, useState } from 'react'
+
+const useTrackErrors = (error?: Error) => {
+  const debouncedErrorMessage = useDebounce(error?.message, 1000)
+
+  useEffect(() => {
+    if (debouncedErrorMessage) {
+      trackEvent({ ...OPENLV_EVENTS.SHOW_ERROR, label: debouncedErrorMessage })
+    }
+  }, [debouncedErrorMessage])
+}
+
+const OpenLVInput = ({ uri }: { uri: string }) => {
+  const { openLV, loading, setLoading } = useContext(OpenLVContext)
+  const [value, setValue] = useState('')
+  const [inputError, setInputError] = useState<Error>()
+  const inputId = useId()
+  useTrackErrors(inputError)
+
+  const onInput = useCallback(
+    async (val: string) => {
+      setValue(val)
+
+      if (val && !isOpenLVUri(val)) {
+        setInputError(new Error('Invalid connection URL'))
+        return
+      }
+
+      setInputError(undefined)
+
+      if (!val) return
+
+      setLoading(OpenLVLoadingState.CONNECT)
+
+      try {
+        const session = await openLV.connect(val)
+
+        trackEvent({ ...OPENLV_EVENTS.CONNECTED, label: session.peerInfo.get()?.identity ?? '' })
+        setValue('')
+      } catch (e) {
+        setInputError(asError(e))
+      }
+
+      setLoading(null)
+    },
+    [openLV, setLoading],
+  )
+
+  useEffect(() => {
+    if (uri) {
+      onInput(uri)
+    }
+  }, [onInput, uri])
+
+  const onPaste = useCallback(async () => {
+    const clipboard = await getClipboard()
+
+    if (clipboard && isOpenLVUri(clipboard)) {
+      onInput(clipboard)
+    }
+  }, [onInput])
+
+  const label = inputError ? inputError.message : 'Connection URL'
+
+  return (
+    <div className="flex w-full flex-col gap-1.5 text-left">
+      <Label htmlFor={inputId} className={inputError ? 'text-destructive' : undefined}>
+        {label}
+      </Label>
+
+      {isClipboardSupported() ? (
+        <Input
+          id={inputId}
+          data-testid="openlv-input"
+          value={value}
+          onChange={(e) => onInput(e.target.value)}
+          autoComplete="off"
+          autoFocus
+          disabled={!!loading}
+          aria-invalid={!!inputError}
+          spellCheck={false}
+        />
+      ) : (
+        <InputGroup>
+          <InputGroupInput
+            id={inputId}
+            data-testid="openlv-input"
+            value={value}
+            onChange={(e) => onInput(e.target.value)}
+            autoComplete="off"
+            autoFocus
+            disabled={!!loading}
+            aria-invalid={!!inputError}
+            spellCheck={false}
+          />
+          <InputGroupAddon align="inline-end" className="pr-0">
+            <Track {...OPENLV_EVENTS.PASTE_CLICK}>
+              <Button variant="default" size="sm" onClick={onPaste} disabled={!!loading}>
+                {loading === OpenLVLoadingState.CONNECT ? <Spinner className="size-5" /> : 'Paste'}
+              </Button>
+            </Track>
+          </InputGroupAddon>
+        </InputGroup>
+      )}
+    </div>
+  )
+}
+
+export default OpenLVInput
