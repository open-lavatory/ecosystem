@@ -0,0 +1,135 @@
+import { connectSession, SessionStatus, type Session } from '@openlv/session'
+import { webrtc } from '@openlv/transport/webrtc'
+import { CONNECT_FAILED_ERROR, CONNECT_TIMEOUT, CONNECT_TIMEOUT_ERROR, SAFE_WALLET_PEER_INFO } from '../constants'
+
+export type OpenLVRequest = {
+  id: number
+  session: Session
+  method: string
+  params?: unknown[] | object
+}
+
+type RequestHandler = (request: OpenLVRequest) => Promise<object>
+
+type SessionHandler = (session: Session) => void
+
+type JsonRpcRequest = { id: number | string | null; method: string; params?: unknown[] | object }
+
+const isRequest = (message: unknown): message is JsonRpcRequest => {
+  return (
+    typeof message === 'object' &&
+    message !== null &&
+    'id' in message &&
+    'method' in message &&
+    typeof message.method === 'string'
+  )
+}
+
+class OpenLVWallet {
+  private sessions: Session[] = []
+  private requestHandler: RequestHandler | undefined
+  private requestId = 0
+  private sessionAddHandlers = new Set<SessionHandler>()
+  private sessionDeleteHandlers = new Set<SessionHandler>()
+
+  public async connect(url: string) {
+    const session: Session = await connectSession(url, (message) => this.handleMessage(session, message), [webrtc()], {
+      info: SAFE_WALLET_PEER_INFO,
+    }).catch(() => {
+      throw new Error(CONNECT_FAILED_ERROR)
+    })
+
+    let timer: number | undefined
+    let status: SessionStatus | 'timeout'
+
+    try {
+      await session.connect()
+
+      const timeout = new Promise<'timeout'>((resolve) => {
+        timer = window.setTimeout(() => resolve('timeout'), CONNECT_TIMEOUT)
+      })
+      status = await Promise.race([
+        session.status.until((value) => value === SessionStatus.CONNECTED || value === SessionStatus.DISCONNECTED),
+        timeout,
+      ])
+    } catch {
+      status = SessionStatus.DISCONNECTED
+    } finally {
+      clearTimeout(timer)
+    }
+
+    if (status !== SessionStatus.CONNECTED) {
+      await session.close().catch(() => undefined)
+      throw new Error(status === 'timeout' ? CONNECT_TIMEOUT_ERROR : CONNECT_FAILED_ERROR)
+    }
+
+    this.sessions.push(session)
+    this.sessionAddHandlers.forEach((handler) => handler(session))
+
+    session.status.subscribe((status) => {
+      if (status === SessionStatus.DISCONNECTED) this.removeSession(session)
+    })
+
+    return session
+  }
+
+  private async handleMessage(session: Session, message: unknown) {
+    if (!this.requestHandler || !isRequest(message)) {
+      throw new Error('Unsupported request')
+    }
+
+    this.requestId += 1
+
+    const response = await this.requestHandler({
+      id: this.requestId,
+      session,
+      method: message.method,
+      params: message.params,
+    })
+
+    return { jsonrpc: '2.0', id: message.id, ...response }
+  }
+
+  private removeSession(session: Session) {
+    if (!this.sessions.includes(session)) return
+
+    this.sessions = this.sessions.filter((item) => item !== session)
+    this.sessionDeleteHandlers.forEach((handler) => handler(session))
+  }
+
+  public onSessionAdd(handler: SessionHandler) {
+    this.sessionAddHandlers.add(handler)
+
+    return () => {
+      this.sessionAddHandlers.delete(handler)
+    }
+  }
+
+  public onSessionDelete(handler: SessionHandler) {
+    this.sessionDeleteHandlers.add(handler)
+
+    return () => {
+      this.sessionDeleteHandlers.delete(handler)
+    }
+  }
+
+  public async disconnectSession(session: Session) {
+    await session.close()
+
+    this.removeSession(session)
+  }
+
+  public getActiveSessions(): Session[] {
+    return this.sessions
+  }
+
+  public onRequest(handler: RequestHandler) {
+    this.requestHandler = handler
+
+    return () => {
+      if (this.requestHandler === handler) this.requestHandler = undefined
+    }
+  }
+}
+
+export default OpenLVWallet
