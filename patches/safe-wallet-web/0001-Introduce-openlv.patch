+import { useCallback, useContext, useEffect } from 'react'
+import { OpenLVContext } from '../OpenLVContext'
+import OpenLVConnectionForm from '../OpenLVConnectionForm'
+import OpenLVErrorMessage from '../OpenLVErrorMessage'
+import OpenLVChainSwitchModal from '../OpenLVChainSwitchModal'
+import { trackEvent } from '@/services/analytics'
+import { OPENLV_EVENTS } from '@/services/analytics/events/openlv'
+import { splitError } from '../../services/utils'
+import { openLVChainSwitchStore } from '../../store/openLVChainSwitchStore'
+
+type OpenLVSessionManagerProps = {
+  uri: string
+}
+
+const OpenLVSessionManager = ({ uri }: OpenLVSessionManagerProps) => {
+  const { sessions, error, setError, open } = useContext(OpenLVContext)
+  const chainSwitchRequest = openLVChainSwitchStore.useStore()
+
+  useEffect(() => {
+    if (!open && chainSwitchRequest) {
+      chainSwitchRequest.onCancel()
+    }
+  }, [open, chainSwitchRequest])
+
+  const onErrorReset = useCallback(() => {
+    setError(null)
+  }, [setError])
+
+  useEffect(() => {
+    if (error) {
+      const label = splitError(error.message || '')[0]
+      trackEvent({ ...OPENLV_EVENTS.SHOW_ERROR, label })
+    }
+  }, [error])
+
+  if (!open && !chainSwitchRequest) return null
+
+  if (chainSwitchRequest) {
+    return (
+      <OpenLVChainSwitchModal
+        appInfo={chainSwitchRequest.appInfo}
+        chain={chainSwitchRequest.chain}
+        safes={chainSwitchRequest.safes}
+        onSelectSafe={chainSwitchRequest.onSelectSafe}
+        onCancel={chainSwitchRequest.onCancel}
+      />
+    )
+  }
+
+  if (error) {
+    return <OpenLVErrorMessage error={error} onClose={onErrorReset} />
+  }
+
+  return <OpenLVConnectionForm sessions={sessions} uri={uri} />
+}
+
+export default OpenLVSessionManager
