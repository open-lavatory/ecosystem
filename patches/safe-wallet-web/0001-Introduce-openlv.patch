+import { useCallback, useContext, useEffect } from 'react'
+import ObservabilityErrorBoundary from '@/components/common/ObservabilityErrorBoundary'
+import useSafeInfo from '@/hooks/useSafeInfo'
+import { OpenLVContext, OpenLVProvider } from '../OpenLVContext'
+import useOpenLVUri from '../../hooks/useOpenLVUri'
+import OpenLVHeaderWidget from '../OpenLVHeaderWidget'
+import OpenLVSessionManager from '../OpenLVSessionManager'
+
+const OpenLVWidget = () => {
+  const { openLV, error, open, setOpen, sessions } = useContext(OpenLVContext)
+  const [uri, clearUri] = useOpenLVUri()
+  const { safeLoaded } = useSafeInfo()
+
+  const onOpen = useCallback(() => {
+    setOpen(true)
+  }, [setOpen])
+
+  const onClose = useCallback(() => {
+    setOpen(false)
+  }, [setOpen])
+
+  useEffect(() => {
+    if (safeLoaded && uri) {
+      onOpen()
+    }
+  }, [safeLoaded, uri, onOpen])
+
+  useEffect(() => {
+    return openLV.onSessionAdd(() => {
+      clearUri()
+      onClose()
+    })
+  }, [openLV, clearUri, onClose])
+
+  return (
+    <OpenLVHeaderWidget isError={!!error} isOpen={open} onOpen={onOpen} onClose={onClose} sessions={sessions}>
+      <OpenLVSessionManager uri={uri} />
+    </OpenLVHeaderWidget>
+  )
+}
+
+const OpenLVUi = () => (
+  <ObservabilityErrorBoundary>
+    <OpenLVProvider>
+      <OpenLVWidget />
+    </OpenLVProvider>
+  </ObservabilityErrorBoundary>
+)
+
+export default OpenLVUi
