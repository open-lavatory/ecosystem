+import SafeAppIconCard from '@safe-global/views/components/safe-apps/SafeAppIconCard'
+import { getPeerIcon, getPeerName } from '../../services/utils'
+import { OpenLVContext } from '../OpenLVContext'
+import { OpenLVLoadingState } from '../../types'
+import useSafeInfo from '@/hooks/useSafeInfo'
+import { trackEvent } from '@/services/analytics'
+import { OPENLV_EVENTS } from '@/services/analytics/events/openlv'
+import { asError } from '@safe-global/utils/services/exceptions/utils'
+import { Button } from '@safe-global/views/components/ui/button'
+import { Spinner } from '@safe-global/views/components/ui/spinner'
+import { List, ListItem } from '@safe-global/views/components/ui/list'
+import { Typography } from '@safe-global/views/components/ui/typography'
+import { cn } from '@safe-global/views/utils/cn'
+import type { Session } from '@openlv/session'
+import { useCallback, useContext } from 'react'
+
+type OpenLVSessionListProps = {
+  sessions: Session[]
+}
+
+const MAX_NAME_LENGTH = 23
+
+const OpenLVSessionListItem = ({ session }: { session: Session }) => {
+  const { openLV, setError, loading, setLoading } = useContext(OpenLVContext)
+
+  const { safeLoaded } = useSafeInfo()
+  const peer = session.peerInfo.get()
+  const icon = getPeerIcon(peer)
+  let name = getPeerName(peer) || 'Unknown dApp'
+
+  if (name.length > MAX_NAME_LENGTH + 1) {
+    name = `${name.slice(0, MAX_NAME_LENGTH)}…`
+  }
+
+  const onDisconnect = useCallback(async () => {
+    trackEvent({ ...OPENLV_EVENTS.DISCONNECT_CLICK, label: peer?.identity ?? '' })
+
+    setLoading(OpenLVLoadingState.DISCONNECT)
+
+    try {
+      await openLV.disconnectSession(session)
+    } catch (error) {
+      setLoading(null)
+      setError(asError(error))
+    }
+
+    setLoading(null)
+  }, [openLV, session, peer, setLoading, setError])
+
+  return (
+    <ListItem className="px-4 min-h-14 rounded-md border border-[var(--color-border-light)]">
+      {icon && (
+        <div className="flex pr-1">
+          <SafeAppIconCard src={icon} alt="icon" width={20} height={20} />
+        </div>
+      )}
+
+      <span className={cn('flex-1 truncate text-sm', safeLoaded ? 'text-foreground' : 'text-muted-foreground')}>
+        {name}
+      </span>
+
+      <Button variant="destructive" size="sm" onClick={onDisconnect} disabled={!!loading}>
+        {loading === OpenLVLoadingState.DISCONNECT ? <Spinner className="size-5" /> : 'Disconnect'}
+      </Button>
+    </ListItem>
+  )
+}
+
+const OpenLVSessionList = ({ sessions }: OpenLVSessionListProps) => {
+  if (sessions.length === 0) {
+    return (
+      <Typography variant="paragraph-small" align="center" className="text-muted-foreground">
+        No dApps are connected yet.
+      </Typography>
+    )
+  }
+
+  return (
+    <List className="flex w-full flex-col gap-1 p-0">
+      {sessions.map((session) => (
+        <OpenLVSessionListItem key={session.getHandshakeParameters().sessionId} session={session} />
+      ))}
+    </List>
+  )
+}
+
+export default OpenLVSessionList
