+  sessionCount: number
+  isError: boolean
+  sessionIcon?: string
+}
+
+const OpenLVIcon = ({ sessionCount, sessionIcon, isError, onClick }: OpenLVIconProps): ReactElement => {
+  const showIcon = sessionCount === 1 && !!sessionIcon
+
+  return (
+    <Track {...OPENLV_EVENTS.POPUP_OPENED}>
