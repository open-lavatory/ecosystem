+import type { PeerInfo } from '@openlv/session'
+import { METHOD_NOT_FOUND, OPENLV_URI_PREFIX, SESSION_ERRORS } from '../constants'
+
+const ICON_PATTERN = /^(https:\/\/|data:image\/(png|jpeg|webp|gif);)/
+
+export const isOpenLVUri = (uri: string): boolean => {
+  return uri.startsWith(OPENLV_URI_PREFIX)
+}
+
+export const getPeerName = (peer: PeerInfo | undefined): string => {
+  return peer?.name ?? ''
+}
+
+export const getPeerIcon = (peer: PeerInfo | undefined): string | undefined => {
+  return peer?.icon && ICON_PATTERN.test(peer.icon) ? peer.icon : undefined
+}
+
+export const splitError = (message: string): string[] => {
+  return message.split(/: (.+)/).slice(0, 2)
+}
+
+export const toSessionResponse = (response: { result: unknown } | { error: { code: number } }) => {
+  if (!('error' in response)) return { result: response.result }
+
+  const code = response.error.code === METHOD_NOT_FOUND ? 4200 : response.error.code
+  const message = SESSION_ERRORS[code]
+
+  return { error: message ? { code, message } : { code: -32603, message: 'Internal error' } }
+}
