+
+const useOpenLVUri = (): [string, () => void] => {
+  const [searchParamUri, setSearchParamUri] = useOpenLVSearchParamUri()
+  const uri = searchParamUri || ''
+
+  const clearUri = useCallback(() => {
+    setSearchParamUri(null)
+  }, [setSearchParamUri])
+
+  return [uri, clearUri]
+}
