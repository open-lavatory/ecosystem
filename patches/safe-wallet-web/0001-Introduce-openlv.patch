+import useSafeInfo from '@/hooks/useSafeInfo'
+import Track from '@/components/common/Track'
+import { OPENLV_EVENTS } from '@/services/analytics/events/openlv'
+import { BRAND_NAME } from '@/config/constants'
+
+const OPENLV_HINTS_KEY = 'openlvHints'
+
+const OpenLVConnectionForm = ({ sessions, uri }: { sessions: Session[]; uri: string }): ReactElement => {
+  const [showHints = true, setShowHints] = useLocalStorage<boolean>(OPENLV_HINTS_KEY)
+  const { safeLoaded } = useSafeInfo()
+
+  const onToggle = useCallback(() => {
+    setShowHints((prev) => !prev)
+  }, [setShowHints])
+
+  useEffect(() => {
+    return () => setShowHints(false)
+  }, [setShowHints])
+
+  return (
+    <div className="relative flex flex-col">
+      <div className="pb-6 text-center">
+        <Tooltip>
+          <TooltipTrigger
+            render={
+              <span className="inline-flex absolute top-0 right-3 h-[50px] items-center">
+                <Track {...(showHints ? OPENLV_EVENTS.HINTS_HIDE : OPENLV_EVENTS.HINTS_SHOW)}>
+                  <Button variant="ghost" size="icon" onClick={onToggle}>
+                    <InfoIcon className="size-6 text-[var(--color-border-main)]" />
+                  </Button>
+                </Track>
+              </span>
+            }
+          />
+          <TooltipContent>
+            {showHints ? 'Hide how WalletConnect/OpenLV works' : 'How does WalletConnect/OpenLV work?'}
+          </TooltipContent>
+        </Tooltip>
+
+        <OpenLVLogoHeader />
+
+        <Typography variant="paragraph-small" className="text-muted-foreground">
+          {safeLoaded
+            ? `Paste the connection URL below to connect to your ${BRAND_NAME} via WalletConnect/OpenLV`
+            : `Please open one of your Safe accounts to connect to via WalletConnect/OpenLV`}
+        </Typography>
+
+        {safeLoaded ? (
+          <div className="mt-6">
+            <OpenLVInput uri={uri} />
+          </div>
+        ) : null}
+      </div>
+      <Separator />
+      <div className="py-6">
+        <OpenLVSessionList sessions={sessions} />
+      </div>
+      {showHints && (
+        <>
+          <Separator />
+
+          <div className="pt-6">
+            <OpenLVHints />
+          </div>
+        </>
+      )}
+    </div>
+  )
+}
+
+export default OpenLVConnectionForm
