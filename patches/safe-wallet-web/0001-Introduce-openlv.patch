@@ -13,6 +13,8 @@ import { trackRequest } from '../../services/tracking'
 import { wcPopupStore } from '../../store/wcPopupStore'
 import type WalletConnectWallet from '../../services/WalletConnectWallet'
 import walletConnectInstance from '../../services/walletConnectInstance'
+import openLVInstance from '../../services/openLVInstance'
+import useOpenLVSessions from '../../hooks/useOpenLVSessions'
 import useLocalStorage from '@/services/local-storage/useLocalStorage'
 import type { WalletConnectContextType, WcAutoApproveProps } from '../../types'
 import { WCLoadingState } from '../../types'
@@ -82,9 +84,18 @@ export const WalletConnectProvider = ({ children }: { children: ReactNode }) =>
     return walletConnect?.onSessionDelete(updateSessions)
   }, [walletConnect, updateSessions])
 
+  const openLVSessions = useOpenLVSessions()
+
+  useEffect(() => {
+    return openLVInstance.onSessionAdd(() => {
+      setLoading(null)
+      setError(null)
+    })
+  }, [])
+
   // The owned-safes list is only needed for dApp-initiated chain switches, so enable it once a
   // session exists.
-  const safeWalletProvider = useSafeWalletProvider(sessions.length > 0)
+  const safeWalletProvider = useSafeWalletProvider(sessions.length + openLVSessions.length > 0)
   const [autoApprove = {}, setAutoApprove] = useLocalStorage<WcAutoApproveProps>(WC_AUTO_APPROVE_KEY)
 
   // Init WalletConnect
@@ -100,6 +111,7 @@ export const WalletConnectProvider = ({ children }: { children: ReactNode }) =>
     if (!walletConnect || !chainId || !safeAddress) return
 
     walletConnect.updateSessions(chainId, safeAddress).catch(setError)
+    openLVInstance.updateSessions(chainId, safeAddress)
   }, [walletConnect, chainId, safeAddress])
 
   //
@@ -154,6 +166,20 @@ export const WalletConnectProvider = ({ children }: { children: ReactNode }) =>
     })
   }, [walletConnect, chainId, safeWalletProvider])
 
+  useEffect(() => {
+    if (!safeWalletProvider || !chainId) return
+
+    return openLVInstance.onRequest(({ id, session, method, params }) => {
+      const peer = session.peerInfo.get()
+
+      return safeWalletProvider.request(
+        id,
+        { method, params },
+        { url: 'https://openlv.sh', name: peer?.name || 'openlv', description: '', iconUrl: peer?.icon ?? '' },
+      )
+    })
+  }, [chainId, safeWalletProvider])
+
   //
   // --- One-click Auth
   //
