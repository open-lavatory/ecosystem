index 000000000..7016bdfc2
--- /dev/null
+++ b/apps/mobile/src/features/WalletConnect/Wallet/services/openLVWallet.ts
@@ -0,0 +1,143 @@
+import type { Session } from '@openlv/react-native'
+
+export const isOpenLVUri = (uri: string): boolean => uri.startsWith('openlv://')
+
+export const OPENLV_TOPIC_PREFIX = 'openlv:'
+
+export const getOpenLVTopic = (session: Session): string =>
+  `${OPENLV_TOPIC_PREFIX}${session.getHandshakeParameters().sessionId}`
+
+export type OpenLVRequest = {
+  id: number
+  topic: string
+  method: string
+  params?: unknown[] | object
+}
+
+export type OpenLVResponse = { id: number } & ({ result: unknown } | { error: { code: number; message: string } })
+
+type RequestHandler = (request: OpenLVRequest) => void
+
+const EIP1193_ERRORS: Record<number, { code: number; message: string }> = {
+  3001: { code: 4100, message: 'Unauthorized' },
+  5000: { code: 4001, message: 'User Rejected Request' },
+  5100: { code: 4901, message: 'Chain Disconnected' },
+  5101: { code: 4200, message: 'Unsupported Method' },
+}
+
+type SessionHandler = () => void
+
+type JsonRpcRequest = { id: number | string | null; method: string; params?: unknown[] | object }
+
+const isRequest = (message: unknown): message is JsonRpcRequest =>
+  typeof message === 'object' &&
+  message !== null &&
+  'id' in message &&
+  'method' in message &&
+  typeof message.method === 'string'
+
+class OpenLVWallet {
+  private sessions: Session[] = []
+  private requestHandler: RequestHandler | undefined
+  private sessionHandlers = new Set<SessionHandler>()
+  private pending = new Map<number, (response: OpenLVResponse) => void>()
+  private lastRequestId = Date.now() * 1000
+
+  public async connect(url: string): Promise<void> {
+    const [{ connectSession, SessionStatus }, { webrtc }] = await Promise.all([
+      import('@openlv/react-native'),
+      import('@openlv/transport/webrtc'),
+    ])
+    const session: Session = await connectSession(url, (message) => this.handleMessage(session, message), [webrtc()])
+
+    await session.connect()
+
+    session.status.subscribe((status) => {
+      if (status === SessionStatus.CONNECTED && !this.sessions.includes(session)) {
+        this.sessions = [...this.sessions, session]
+        this.sessionHandlers.forEach((handler) => handler())
+      }
+
+      if (status === SessionStatus.DISCONNECTED) {
+        this.removeSession(session)
+      }
+    })
+  }
+
+  private async handleMessage(session: Session, message: unknown): Promise<object> {
+    const handler = this.requestHandler
+    if (!handler || !isRequest(message)) {
+      throw new Error('Unsupported request')
+    }
+
+    this.lastRequestId += 1
+    const id = this.lastRequestId
+    const response = await new Promise<OpenLVResponse>((resolve) => {
+      this.pending.set(id, resolve)
+      handler({ id, topic: getOpenLVTopic(session), method: message.method, params: message.params })
+    })
+
+    if ('error' in response) {
+      return { jsonrpc: '2.0', id: message.id, error: EIP1193_ERRORS[response.error.code] ?? response.error }
+    }
+    return { jsonrpc: '2.0', id: message.id, result: response.result }
+  }
+
+  public respond(response: OpenLVResponse) {
+    this.pending.get(response.id)?.(response)
+    this.pending.delete(response.id)
+  }
+
+  private removeSession(session: Session) {
+    if (!this.sessions.includes(session)) {
+      return
+    }
+
+    this.sessions = this.sessions.filter((item) => item !== session)
+    this.sessionHandlers.forEach((handler) => handler())
+  }
+
+  public async disconnect(topic: string) {
+    const session = this.sessions.find((item) => getOpenLVTopic(item) === topic)
+
+    if (!session) {
+      return
+    }
+
+    await session.close()
+    this.removeSession(session)
+  }
+
+  public getSessions(): Session[] {
+    return this.sessions
+  }
+
+  public onSessionsChange(handler: SessionHandler) {
+    this.sessionHandlers.add(handler)
+
+    return () => {
+      this.sessionHandlers.delete(handler)
+    }
+  }
+
+  public updateSessions(chainId: string, safeAddress: string) {
+    this.sessions.forEach((session) => {
+      session.send({ jsonrpc: '2.0', method: 'accountsChanged', params: [[safeAddress]] }).catch(() => undefined)
+      session
+        .send({ jsonrpc: '2.0', method: 'chainChanged', params: [`0x${Number(chainId).toString(16)}`] })
+        .catch(() => undefined)
+    })
+  }
+
+  public onRequest(handler: RequestHandler) {
+    this.requestHandler = handler
+
+    return () => {
+      if (this.requestHandler === handler) {
+        this.requestHandler = undefined
+      }
+    }
+  }
+}
+
+export const openLVWallet = new OpenLVWallet()
