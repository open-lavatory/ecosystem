@@ -0,0 +1,35 @@
+import React, { useEffect } from 'react'
+import { useStore } from 'react-redux'
+import { OpenLVGlobals } from '@openlv/react-native'
+import { FEATURES } from '@safe-global/utils/utils/chains'
+import { useHasFeature } from '@/src/hooks/useHasFeature'
+import { useAppDispatch } from '@/src/store/hooks'
+import { type RootState } from '@/src/store'
+import { selectActiveSafe } from '@/src/store/activeSafeSlice'
+import { sessionRequestReceived } from './store/walletKitSlice'
+import { openLVWallet } from './services/openLVWallet'
+
+export const OpenLVController: React.FC = () => {
+  const isEnabled = useHasFeature(FEATURES.NATIVE_WALLETCONNECT) ?? false
+  const dispatch = useAppDispatch()
+  const store = useStore<RootState>()
+
+  useEffect(() => {
+    if (!isEnabled) {
+      return
+    }
+    return openLVWallet.onRequest(({ id, topic, method, params }) => {
+      const chainId = selectActiveSafe(store.getState())?.chainId ?? ''
+      dispatch(
+        sessionRequestReceived({
+          id,
+          topic,
+          params: { request: { method, params }, chainId: `eip155:${chainId}` },
+          verifyContext: { verified: { origin: '', validation: 'UNKNOWN', verifyUrl: '' } },
+        }),
+      )
+    })
+  }, [dispatch, store, isEnabled])
+
+  return isEnabled ? <OpenLVGlobals /> : null
+}
