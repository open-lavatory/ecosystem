diff --git a/src/mobile/modules/wallet-connect/services/openlvService.ts b/src/mobile/modules/wallet-connect/services/openlvService.ts
new file mode 100644
index 0000000..2032099
--- /dev/null
+++ b/src/mobile/modules/wallet-connect/services/openlvService.ts
@@ -0,0 +1,261 @@
+import { connectSession, type Session, SessionStatus } from '@openlv/react-native'
+
+import { ToastOptions } from '@common/contexts/toastContext/toastContext'
+import { Action, MethodAction } from '@common/types/actions'
+
+type DispatchFn = (action: MethodAction | Action, windowId?: number, raw?: boolean) => void
+type AddToastFn = (text: string, options?: ToastOptions) => void
+
+type ProviderResponse = { result: unknown } | { error: unknown }
+
+type OpenlvSession = {
+  session: Session
+  proposalId: number
+  // Differs from the proposal's tab, so requests can't land on the session of the connect request
+  tabId: number
+  url: string
+  name: string
+  icon?: string
+  isApproved: boolean
+  approval: Promise<void>
+  approve: () => void
+  pendingRequests: Map<number, (response: ProviderResponse) => void>
+}
+
+const OPENLV_TOPIC_PREFIX = 'openlv:'
+
+const sessionsByTopic = new Map<string, OpenlvSession>()
+let addToastFn: AddToastFn | null = null
+let lastRequestId = 0
+
+export const isOpenlvUri = (uri: string) => uri.startsWith('openlv://')
+export const isOpenlvTopic = (topic: string) => topic.startsWith(OPENLV_TOPIC_PREFIX)
+
+const getTempSessionTopic = (proposalId: number) => `temp_wallet_connect_session_${proposalId}`
+
+const findByProposalId = (proposalId: number) =>
+  [...sessionsByTopic].find(([, entry]) => entry.proposalId === proposalId)
+
+export const isOpenlvProposal = (proposalId: number) => !!findByProposalId(proposalId)
+
+const propose = (topic: string, session: Session, dispatch: DispatchFn) => {
+  const peer = session.peerInfo.get()
+  const proposalId = Date.now() * 1000 + Math.floor(Math.random() * 1000)
+  // The peer identity is reverse DNS, e.g. sh.openlv.docs for docs.openlv.sh
+  const url = `https://${peer ? peer.identity.split('.').reverse().join('.') : 'openlv.sh'}`
+  const name = peer?.name ?? 'openlv'
+  let approve = () => {}
+  const approval = new Promise<void>((resolve) => {
+    approve = resolve
+  })
+
+  sessionsByTopic.set(topic, {
+    session,
+    proposalId,
+    tabId: proposalId + 1,
+    url,
+    name,
+    icon: peer?.icon,
+    isApproved: false,
+    approval,
+    approve,
+    pendingRequests: new Map()
+  })
+
+  dispatch(
+    {
+      type: 'HANDLE_PROVIDER_REQUEST',
+      params: {
+        request: { method: 'tabCheckin', origin: url, params: { name, icon: peer?.icon } },
+        requestId: 0,
+        providerId: 1,
+        topic: getTempSessionTopic(proposalId),
+        tabId: proposalId,
+        isWalletConnect: true
+      }
+    },
+    undefined,
+    true
+  )
+
+  dispatch(
+    {
+      type: 'HANDLE_PROVIDER_REQUEST',
+      params: {
+        request: { method: 'eth_requestAccounts', origin: url },
+        requestId: proposalId,
+        providerId: 1,
+        topic: getTempSessionTopic(proposalId),
+        tabId: proposalId,
+        isWalletConnect: true
+      }
+    },
+    undefined,
+    true
+  )
+}
+
+const end = (topic: string, dispatch: DispatchFn) => {
+  const entry = sessionsByTopic.get(topic)
+  if (!entry) return
+
+  sessionsByTopic.delete(topic)
+
+  if (!entry.isApproved) {
+    dispatch({
+      type: 'method',
+      params: {
+        method: 'deleteDappSessionByWcTopic',
+        ctrlName: 'DappsController',
+        args: [getTempSessionTopic(entry.proposalId)]
+      }
+    })
+    return
+  }
+
+  dispatch({
+    type: 'method',
+    params: {
+      method: 'disconnectWcSessionByTopic',
+      ctrlName: 'DappsController',
+      args: [topic]
+    }
+  })
+  addToastFn?.(`${entry.name} disconnected from your wallet.`, { type: 'info' })
+}
+
+const handleRequest = async (topic: string, message: unknown, dispatch: DispatchFn) => {
+  const entry = sessionsByTopic.get(topic)
+  if (!entry) throw new Error('openlv session not found')
+  if (!message || typeof message !== 'object' || !('method' in message) || !('id' in message)) {
+    throw new Error('Invalid openlv request')
+  }
+
+  await entry.approval
+
+  // Requests of a session must have increasing ids, see setSessionLastHandledRequestsId
+  lastRequestId = Math.max(Date.now() * 1000, lastRequestId + 1)
+  const requestId = lastRequestId
+
+  const response = await new Promise<ProviderResponse>((resolve) => {
+    entry.pendingRequests.set(requestId, resolve)
+    dispatch(
+      {
+        type: 'HANDLE_PROVIDER_REQUEST',
+        params: {
+          request: {
+            method: String(message.method),
+            params: 'params' in message ? message.params : undefined,
+            origin: entry.url
+          },
+          requestId,
+          providerId: 1,
+          topic,
+          tabId: entry.tabId,
+          isWalletConnect: true
+        }
+      },
+      undefined,
+      true
+    )
+  })
+
+  return { jsonrpc: '2.0', id: message.id, ...response }
+}
+
+export const connectOpenlv = async (uri: string, dispatch: DispatchFn, addToast: AddToastFn) => {
+  addToastFn = addToast
+
+  // Loaded on demand, so WebRTC is first touched after OpenLVGlobals installed its polyfills
+  const { loadTransport } = await import('@openlv/session')
+  const webrtc = await loadTransport('webrtc')
+  let topic = ''
+  const session = await connectSession(
+    uri,
+    (message) => handleRequest(topic, message, dispatch),
+    [webrtc()],
+    {
+      info: {
+        identity: 'com.ambire.wallet',
+        name: 'Ambire Wallet',
+        icon: 'https://ambire.com/wallet-logo.png'
+      }
+    }
+  )
+  topic = `${OPENLV_TOPIC_PREFIX}${session.getHandshakeParameters().sessionId}`
+
+  session.status.subscribe((status) => {
+    if (status === SessionStatus.CONNECTED && !sessionsByTopic.has(topic)) {
+      propose(topic, session, dispatch)
+    }
+    if (status === SessionStatus.DISCONNECTED) {
+      end(topic, dispatch)
+      // A session that fails on its own only reports it, closing releases its relay and peer
+      void session.close()
+    }
+  })
+
+  await session.connect().catch(async (error: unknown) => {
+    await session.close()
+    throw error
+  })
+}
+
+export const approveOpenlvSession = (proposalId: number, dispatch: DispatchFn) => {
+  const [topic, entry] = findByProposalId(proposalId) ?? []
+  if (!topic || !entry) return
+
+  dispatch(
+    {
+      type: 'SETUP_WC_SESSION_MESSENGER',
+      params: {
+        url: entry.url,
+        tabId: entry.tabId,
+        topic,
+        chainId: 1,
+        name: entry.name,
+        icon: entry.icon,
+        tempSessionTopic: getTempSessionTopic(proposalId)
+      }
+    },
+    undefined,
+    true
+  )
+
+  entry.isApproved = true
+  entry.approve()
+  addToastFn?.('Connected! You can return to the browser.', { type: 'success' })
+}
+
+export const rejectOpenlvSession = async (proposalId: number) => {
+  await findByProposalId(proposalId)?.[1].session.close()
+}
+
+export const respondToOpenlvRequest = (topic: string, id: number, response: ProviderResponse) => {
+  const pendingRequests = sessionsByTopic.get(topic)?.pendingRequests
+
+  pendingRequests?.get(id)?.(
+    'error' in response ? { error: response.error } : { result: response.result ?? null }
+  )
+  pendingRequests?.delete(id)
+}
+
+export const handleOpenlvSessionBroadcast = async (topic: string, event: string, data: unknown) => {
+  const entry = sessionsByTopic.get(topic)
+  if (!entry) return
+
+  if (event === 'disconnect') {
+    // Dropped first, so the session's own end doesn't report a disconnect by the app
+    sessionsByTopic.delete(topic)
+    await entry.session.close()
+    return
+  }
+
+  if (event === 'accountsChanged') {
+    await entry.session.send({ jsonrpc: '2.0', method: event, params: [data] })
+  } else if (event === 'chainChanged') {
+    // ProviderController broadcasts { chain, networkVersion }, other callers the hex chain id
+    const chain = data && typeof data === 'object' && 'chain' in data ? data.chain : data
+    await entry.session.send({ jsonrpc: '2.0', method: event, params: [chain] })
+  }
+}
