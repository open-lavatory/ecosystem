      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "A live site; nothing is built"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "const": "open-lavatory",
              "description": "A flake input of bench/flake.nix"
            },
            "build": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Shell commands run once per input revision"
            },
            "serve": {
              "type": "string",
              "format": "includes",
              "pattern": "\\{port\\}",
              "description": "Shell command that serves the build on {port}"
            }
          },
          "required": [
            "input",
            "build",
            "serve"
          ],
          "additionalProperties": false
        }
      ]
    },
    "chains": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "description": "Chains the app knows; the test wallet starts on the first"
    },
    "rpc": {
      "description": "URL globs of the app's RPC, routed to the local chain with that id",
      "type": "object",
      "propertyNames": {
        "type": "string"
