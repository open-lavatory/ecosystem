{
  "$schema": "./descriptor.schema.json",
  "name": "wallet.page",
  "source": { "url": "https://wallet.page" },
  "chains": [1, 11155111],
  "open": "/signatures",
  "connect": [
    { "click": "role=button[name='Connect wallet']" },
    { "click": "role=button[name=/company\\.v3x\\.openlv/]" },
    { "click": "role=button[name='Generate QR']" },
    { "click": "role=button[name='Copy Connection URL']" },
    { "url": "clipboard" }
  ],
  "connected": [
    { "visible": "text=0x7099...79C8" },
    { "hidden": "text=\"Connect Wallet\"" }
  ],
  "disconnect": {
    "steps": [
      { "click": "role=button[name=/0x7099\\.\\.\\.79C8/]" },
      { "click": "role=menuitem[name='Disconnect']" }
    ],
    "disconnected": [{ "visible": "role=button[name='Connect wallet']" }]
  },
  "actions": [
    {
      "name": "sign",
      "features": ["personal_sign"],
      "steps": [{ "click": "role=button[name='Sign message']" }],
      "request": { "method": "personal_sign", "message": "wallet.page - personal_sign test" },
      "approved": [
        { "click": "role=tab[name='Response']" },
        { "visible": "role=tabpanel >> text=/^0x[0-9a-f]{130}$/" }
      ],
      "rejected": [
        { "click": "role=tab[name='Response']" },
        { "visible": "role=tabpanel >> text=/User Rejected Request/" }
      ]
    },
    {
      "name": "accounts",
      "open": "/addresses",
      "features": ["multiple_accounts"],
      "steps": [{ "click": "role=button[name='Call eth_accounts']" }],
      "request": { "method": "eth_accounts" },
      "approved": [
        { "click": "role=tab[name='Response']" },
        { "visible": "role=tabpanel[name='Response'] >> text=/^\\[\\s*\"{account0}\",\\s*\"{account1}\"\\s*\\]$/" }
      ]
    },
    {
      "name": "permit",
      "open": "/approvals",
      "features": ["typed_data", "permit"],
      "steps": [{ "click": "role=button[name='Sign permit']" }],
      "request": { "method": "eth_signTypedData_v4", "primaryType": "Permit" },
      "approved": [
        { "click": "role=tab[name='Response']" },
        { "visible": "role=tabpanel >> text=/^0x[0-9a-f]{130}$/" }
      ],
      "rejected": [
        { "click": "role=tab[name='Response']" },
        { "visible": "role=tabpanel >> text=/User Rejected Request/" }
      ]
    },
    {
      "name": "transaction",
      "open": "/transactions",
      "features": ["transaction"],
      "steps": [{ "click": "role=button[name='Send test transaction']" }],
      "request": { "method": "eth_sendTransaction" },
      "approved": [
        { "click": "role=tab[name='Response']" },
        { "visible": "role=tabpanel >> text=/^0x[0-9a-f]{64}$/" }
      ],
      "rejected": [
        { "click": "role=tab[name='Response']" },
        { "visible": "role=tabpanel >> text=/User Rejected Request/" }
      ]
    },
    {
      "name": "switch-chain",
      "open": "/networks",
      "features": ["chain_switch"],
      "steps": [{ "click": "role=button[name='Switch']" }],
      "request": { "method": "wallet_switchEthereumChain", "chainId": 11155111 },
      "approved": [{ "visible": "text=Active chain: 0xaa36a7" }]
    }
  ],
  "gaps": [
    {
      "feature": "account_switch",
      "reason": "wallet.page answers the wallet's accountsChanged with -32601 Method not found, and its wallet chip keeps the first account"
    },
    {
      "feature": "wallet_chain_switch",
      "reason": "wallet.page answers the wallet's chainChanged with -32601 Method not found, and /networks keeps showing the first chain as active"
    }
  ]
}
