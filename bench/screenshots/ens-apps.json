{
  "$schema": "./schema.json",
  "name": "ENS apps",
  "source": {
    "patch": "ens-apps",
    "build": [
      "NODE_OPTIONS=--max-old-space-size=4096 pnpm install --frozen-lockfile --ignore-scripts --config.minimum-release-age=0 --filter portal...",
      "cd apps/portal && NODE_OPTIONS=--max-old-space-size=4096 node node_modules/vite/bin/vite.js build"
    ],
    "serve": "cd apps/portal && exec node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port {port} --strictPort"
  },
  "viewport": { "width": 1280, "height": 800 },
  "steps": [
    { "goto": "/" },
    { "click": "role=button[name='No thanks']" },
    { "click": "role=button[name='Connect wallet']" },
    { "visible": "role=dialog >> role=button[name='Open Lavatory']" }
  ],
  "element": "role=dialog"
}
